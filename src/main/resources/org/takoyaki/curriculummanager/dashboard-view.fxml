<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.takoyaki.curriculummanager.controller.DashboardController"
        spacing="25">

    <padding>
        <Insets
                top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <!-- タイトル -->
    <Label
            text="ダッシュボード"
            style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <!-- 全年度を対象にした全体集計 -->
    <HBox spacing="55" alignment="CENTER_LEFT">

        <VBox spacing="5">
            <Label text="全年度 合計GPA" style="-fx-font-size: 14px;"/>
            <Label fx:id="gpaLabel" text="0.00" style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
        </VBox>

        <VBox spacing="5">
            <Label text="全年度 合計修得単位" style="-fx-font-size: 14px;"/>
            <Label fx:id="earnedCreditsLabel" text="0.0 単位" style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
        </VBox>

        <VBox spacing="5">
            <Label text="現在の卒業判定" style="-fx-font-size: 14px;"/>
            <Label fx:id="graduationPossibleLabel" text="卒業不可" style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
        </VBox>

        <Button text="情報を更新" onAction="#refresh" prefWidth="130"/>

    </HBox>

    <!-- ダッシュボード本体 -->
    <HBox
            spacing="40"
            VBox.vgrow="ALWAYS">

        <!-- 左側：年度別の情報 -->
        <VBox
                spacing="10"
                prefWidth="390">

            <Label text="年度別 GPA・修得単位" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <TableView fx:id="yearlySummaryTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="yearColumn" text="年度" prefWidth="100"/>
                    <TableColumn fx:id="yearlyGpaColumn" text="GPA" prefWidth="120"/>
                    <TableColumn fx:id="yearlyCreditsColumn" text="修得単位" prefWidth="150"/>
                </columns>
                <placeholder>
                    <Label text="年度が登録された履修はありません。"/>
                </placeholder>
            </TableView>

        </VBox>

        <!-- 右側：カリキュラム一覧 -->
        <VBox
                spacing="10"
                HBox.hgrow="ALWAYS">

            <Label
                    text="カリキュラム・卒業要件一覧"
                    style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <ListView
                    fx:id="curriculumRequirementListView"
                    VBox.vgrow="ALWAYS"
                    HBox.hgrow="ALWAYS">

                <!-- 一覧が空の場合に表示するNode -->
                <placeholder>
                    <Label
                            text="登録されているカリキュラムがありません。"/>
                </placeholder>

            </ListView>

        </VBox>

    </HBox>

</VBox>
