<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.takoyaki.curriculummanager.controller.DashboardController"
        stylesheets="@style.css"
        styleClass="content-scroll"
        fitToWidth="true"
        hbarPolicy="AS_NEEDED"
        vbarPolicy="AS_NEEDED">

    <content>
        <VBox spacing="14" styleClass="page" minWidth="0">
            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>

            <Label text="%nav.dashboard" styleClass="title-label"/>

            <VBox spacing="9" styleClass="toolbar-card">
                <Label fx:id="academicContextLabel" text="%common.notConfigured" styleClass="context-label"/>

                <FlowPane styleClass="responsive-flow" prefWrapLength="760">
                    <HBox styleClass="field-group">
                        <Label text="%common.department"/>
                        <ComboBox fx:id="departmentComboBox" styleClass="compact-combo" promptText="%common.department.select"/>
                    </HBox>
                    <Button text="%common.department.add" onAction="#addDepartment" styleClass="primary-button"/>

                    <HBox styleClass="field-group">
                        <Label text="%common.major"/>
                        <ComboBox fx:id="majorComboBox" styleClass="compact-combo" promptText="%common.major.select"/>
                    </HBox>
                    <Button text="%common.major.add" onAction="#addMajor" styleClass="primary-button"/>
                </FlowPane>
            </VBox>

            <FlowPane styleClass="responsive-flow" prefWrapLength="760">
                <VBox spacing="5" styleClass="card,dashboard-card">
                    <Label text="%dashboard.totalGpa" styleClass="dashboard-caption"/>
                    <Label fx:id="gpaLabel" text="0.00" styleClass="dashboard-value"/>
                </VBox>

                <VBox spacing="5" styleClass="card,dashboard-card">
                    <Label text="%dashboard.totalCredits" styleClass="dashboard-caption"/>
                    <Label fx:id="earnedCreditsLabel" text="%dashboard.creditsValue" styleClass="dashboard-value"/>
                </VBox>

                <VBox spacing="5" styleClass="card,dashboard-card">
                    <Label text="%dashboard.graduationStatus" styleClass="dashboard-caption"/>
                    <Label fx:id="graduationPossibleLabel" text="%dashboard.notGraduated" styleClass="dashboard-value"/>
                </VBox>

                <Button text="%dashboard.refresh" onAction="#refresh" styleClass="secondary-button"/>
            </FlowPane>

            <VBox spacing="14" VBox.vgrow="ALWAYS">
                <VBox spacing="8" styleClass="card">
                    <Label text="%dashboard.yearlySummary" styleClass="section-title"/>

                    <TableView fx:id="yearlySummaryTable" prefHeight="220">
                        <columns>
                            <TableColumn fx:id="yearColumn" text="%common.year" minWidth="90" prefWidth="100"/>
                            <TableColumn fx:id="yearlyGpaColumn" text="GPA" minWidth="90" prefWidth="110"/>
                            <TableColumn fx:id="yearlyCreditsColumn" text="%common.earnedCredits" minWidth="120" prefWidth="150"/>
                        </columns>
                        <placeholder>
                            <Label text="%dashboard.noYearlyData"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
                    <Label text="%dashboard.requirements" styleClass="section-title"/>

                    <ListView fx:id="curriculumRequirementListView"
                              prefHeight="260"
                              VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="%dashboard.noCurricula"/>
                        </placeholder>
                    </ListView>
                </VBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
