<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.takoyaki.curriculummanager.controller.GraduationController"
        stylesheets="@style.css"
        styleClass="content-scroll"
        fitToWidth="true"
        hbarPolicy="AS_NEEDED"
        vbarPolicy="AS_NEEDED">

    <content>
        <VBox spacing="12" styleClass="page" minWidth="0">
            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>

            <Label text="%graduation.title" styleClass="title-label"/>

            <VBox spacing="9" styleClass="toolbar-card">
                <Label fx:id="academicContextLabel" text="%common.notConfigured" styleClass="context-label"/>

                <FlowPane styleClass="responsive-flow" prefWrapLength="760">
                    <HBox styleClass="field-group">
                        <Label text="%common.curriculum"/>
                        <ComboBox fx:id="curriculumComboBox" styleClass="wide-combo" promptText="%common.curriculum.select"/>
                    </HBox>

                    <Button text="%graduation.add" onAction="#addRequirement" styleClass="primary-button"/>
                    <Button text="%graduation.edit" onAction="#editRequirement" styleClass="secondary-button"/>
                    <Button text="%common.refresh" onAction="#refresh" styleClass="secondary-button"/>
                </FlowPane>
            </VBox>

            <FlowPane styleClass="responsive-flow" prefWrapLength="760">
                <VBox spacing="5" styleClass="card,graduation-summary-card">
                    <Label text="%graduation.judgement" styleClass="dashboard-caption"/>
                    <Label fx:id="graduationStatusLabel"
                           text="%graduation.curriculumNotSelected"
                           wrapText="true"
                           styleClass="graduation-summary-value"/>
                </VBox>

                <VBox spacing="5" styleClass="card,graduation-summary-card">
                    <Label text="%common.earnedCredits" styleClass="dashboard-caption"/>
                    <Label fx:id="totalCreditsLabel"
                           text="%graduation.creditsValue"
                           wrapText="true"
                           styleClass="graduation-summary-value"/>
                </VBox>
            </FlowPane>

            <VBox spacing="8" styleClass="card">
                <Label text="%graduation.title" styleClass="section-title"/>

                <TableView fx:id="requirementTable" prefHeight="240">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="%graduation.requirement" minWidth="180" prefWidth="230"/>
                        <TableColumn fx:id="targetCategoriesColumn" text="%graduation.target" minWidth="220" prefWidth="300"/>
                        <TableColumn fx:id="requiredColumn" text="%graduation.requiredCredits" minWidth="90" prefWidth="100"/>
                        <TableColumn fx:id="earnedColumn" text="%common.earnedCredits" minWidth="90" prefWidth="100"/>
                        <TableColumn fx:id="remainingColumn" text="%graduation.remaining" minWidth="75" prefWidth="90"/>
                        <TableColumn fx:id="statusColumn" text="%common.status" minWidth="80" prefWidth="90"/>
                    </columns>
                    <placeholder>
                        <Label text="%graduation.noRequirements"/>
                    </placeholder>
                </TableView>
            </VBox>

            <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
                <Label text="%graduation.mandatoryCourses" styleClass="section-title"/>

                <TableView fx:id="mandatoryCourseTable" prefHeight="250" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="mandatoryCourseCodeColumn" text="%common.course.code" minWidth="110" prefWidth="140"/>
                        <TableColumn fx:id="mandatoryCourseNameColumn" text="%common.course.name" minWidth="240" prefWidth="360"/>
                        <TableColumn fx:id="mandatoryCreditsColumn" text="%common.credits" minWidth="70" prefWidth="80"/>
                        <TableColumn fx:id="mandatoryStatusColumn" text="%graduation.completionStatus" minWidth="100" prefWidth="120"/>
                    </columns>
                    <placeholder>
                        <Label text="%graduation.noMandatoryCourses"/>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
