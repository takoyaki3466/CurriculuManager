<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.takoyaki.curriculummanager.controller.GraduationController"
        stylesheets="@style.css"
        styleClass="content-scroll"
        fitToWidth="true"
        hbarPolicy="AS_NEEDED"
        vbarPolicy="AS_NEEDED">

    <content>
        <VBox spacing="12" styleClass="page" minWidth="0">
            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>

            <Label text="卒業要件" styleClass="title-label"/>

            <VBox spacing="9" styleClass="toolbar-card">
                <Label fx:id="academicContextLabel" text="学部・学科未設定" styleClass="context-label"/>

                <FlowPane styleClass="responsive-flow" prefWrapLength="760">
                    <HBox styleClass="field-group">
                        <Label text="カリキュラム"/>
                        <ComboBox fx:id="curriculumComboBox" styleClass="wide-combo" promptText="カリキュラムを選択"/>
                    </HBox>

                    <Button text="卒業要件追加" onAction="#addRequirement" styleClass="primary-button"/>
                    <Button text="卒業要件編集" onAction="#editRequirement" styleClass="secondary-button"/>
                    <Button text="更新" onAction="#refresh" styleClass="secondary-button"/>
                </FlowPane>
            </VBox>

            <FlowPane styleClass="responsive-flow" prefWrapLength="760">
                <VBox spacing="5" styleClass="card,graduation-summary-card">
                    <Label text="卒業判定" styleClass="dashboard-caption"/>
                    <Label fx:id="graduationStatusLabel"
                           text="カリキュラム未選択"
                           wrapText="true"
                           styleClass="graduation-summary-value"/>
                </VBox>

                <VBox spacing="5" styleClass="card,graduation-summary-card">
                    <Label text="修得単位" styleClass="dashboard-caption"/>
                    <Label fx:id="totalCreditsLabel"
                           text="修得単位: 0.0"
                           wrapText="true"
                           styleClass="graduation-summary-value"/>
                </VBox>
            </FlowPane>

            <VBox spacing="8" styleClass="card">
                <Label text="卒業要件" styleClass="section-title"/>

                <TableView fx:id="requirementTable" prefHeight="240">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="要件" minWidth="180" prefWidth="230"/>
                        <TableColumn fx:id="targetCategoriesColumn" text="対象" minWidth="220" prefWidth="300"/>
                        <TableColumn fx:id="requiredColumn" text="必要単位" minWidth="90" prefWidth="100"/>
                        <TableColumn fx:id="earnedColumn" text="修得単位" minWidth="90" prefWidth="100"/>
                        <TableColumn fx:id="remainingColumn" text="残り" minWidth="75" prefWidth="90"/>
                        <TableColumn fx:id="statusColumn" text="状態" minWidth="80" prefWidth="90"/>
                    </columns>
                    <placeholder>
                        <Label text="卒業要件が登録されていません。"/>
                    </placeholder>
                </TableView>
            </VBox>

            <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
                <Label text="必修科目" styleClass="section-title"/>

                <TableView fx:id="mandatoryCourseTable" prefHeight="250" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="mandatoryCourseCodeColumn" text="科目コード" minWidth="110" prefWidth="140"/>
                        <TableColumn fx:id="mandatoryCourseNameColumn" text="科目名" minWidth="240" prefWidth="360"/>
                        <TableColumn fx:id="mandatoryCreditsColumn" text="単位" minWidth="70" prefWidth="80"/>
                        <TableColumn fx:id="mandatoryStatusColumn" text="修得状況" minWidth="100" prefWidth="120"/>
                    </columns>
                    <placeholder>
                        <Label text="必修科目が登録されていません。"/>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
