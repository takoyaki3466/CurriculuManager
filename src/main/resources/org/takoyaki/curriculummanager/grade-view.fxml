<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.takoyaki.curriculummanager.controller.GradeController">

    <top>
        <VBox spacing="10">

            <padding>
                <Insets
                        top="15"
                        right="15"
                        bottom="15"
                        left="15"/>
            </padding>

            <HBox
                    spacing="15"
                    alignment="CENTER_LEFT">

                <Label
                        text="成績"
                        style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <Button
                        text="更新"
                        onAction="#refresh"/>

            </HBox>

            <!-- 学部とカリキュラムの選択 -->
            <HBox
                    spacing="10"
                    alignment="CENTER_LEFT">

                <Label
                        text="学部"/>

                <ComboBox
                        fx:id="departmentComboBox"
                        prefWidth="180"/>

                <Label
                        text="カリキュラム"/>

                <ComboBox
                        fx:id="curriculumComboBox"
                        prefWidth="250"/>

            </HBox>

        </VBox>
    </top>

    <center>
        <TableView
                fx:id="gradeTable"
                editable="true"
                prefHeight="500">

            <columns>

                <TableColumn
                        fx:id="yearColumn"
                        text="年度"
                        prefWidth="70"/>

                <TableColumn
                        fx:id="semesterColumn"
                        text="学期"
                        prefWidth="90"/>

                <TableColumn
                        fx:id="courseCodeColumn"
                        text="科目コード"
                        prefWidth="110"/>

                <TableColumn
                        fx:id="courseNameColumn"
                        text="科目名"
                        prefWidth="250"/>

                <TableColumn
                        fx:id="creditsColumn"
                        text="単位"
                        prefWidth="70"/>

                <TableColumn
                        fx:id="gradeColumn"
                        text="成績"
                        prefWidth="100"/>

            </columns>

        </TableView>
    </center>

</BorderPane>
