<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        stylesheets="@style.css"
        styleClass="page"
        fx:controller="org.takoyaki.curriculummanager.controller.MainController">

    <top>
        <VBox spacing="3" styleClass="app-header">
            <padding>
                <Insets top="12" right="14" bottom="12" left="14"/>
            </padding>
            <Label text="%app.title" styleClass="app-title"/>
            <Label text="%app.subtitle" styleClass="secondary-label"/>
        </VBox>
    </top>

    <center>
        <HBox>
            <VBox spacing="6" prefWidth="150" minWidth="135" maxWidth="165" styleClass="sidebar">
                <padding>
                    <Insets top="12" right="8" bottom="12" left="8"/>
                </padding>

                <Label text="%nav.menu" styleClass="section-title"/>
                <Button text="%nav.dashboard" onAction="#openDashboard" maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="%nav.enrollment" onAction="#openEnrollment" maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="%nav.grade" onAction="#openGrade" maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="%nav.curriculum" onAction="#openCurriculum" maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="%nav.graduation" onAction="#openGraduation" maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="%nav.databaseTransfer" onAction="#openDatabaseTransfer" maxWidth="Infinity" wrapText="true" styleClass="nav-button"/>
                <Button text="%nav.qa" onAction="#openQa" maxWidth="Infinity" styleClass="nav-button"/>
            </VBox>

            <StackPane fx:id="contentPane" minWidth="0" HBox.hgrow="ALWAYS" styleClass="content-area"/>
        </HBox>
    </center>

</BorderPane>
